# RiverLab local configuration. Copy to `.env` and change the password:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=riverlab
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=riverlab
# Host port for PostgreSQL (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
RIVERLAB_ENV=development
# Used when running the backend on the host. Inside docker compose the host is `postgres`.
RIVERLAB_DATABASE_URL=postgresql+psycopg://riverlab:change-me-local-only@localhost:5432/riverlab
# Test database; tests refuse to run against a database whose name does not end in `_test`.
RIVERLAB_TEST_DATABASE_URL=postgresql+psycopg://riverlab:change-me-local-only@localhost:5432/riverlab_test
RIVERLAB_LOG_LEVEL=INFO
# Comma-separated origins. Leave empty: the frontend uses a same-origin proxy (ADR-0006).
RIVERLAB_CORS_ORIGINS=
RIVERLAB_EQUITY_EXACT_BUDGET=50000000
RIVERLAB_EQUITY_MAX_ITERATIONS=2000000
# In-process GTOpen solver: one solve at a time, refused above this memory estimate.
RIVERLAB_SOLVER_ENABLED=true
RIVERLAB_SOLVER_MAX_MEMORY_MB=2048
# 0 = all CPU cores.
RIVERLAB_SOLVER_THREADS=0
# Saved solve trees for browsing (each about the solve's memory size; delete solves to free space).
RIVERLAB_RESULT_STORAGE_DIR=data/solver-results
RIVERLAB_RESULT_CACHE_SIZE=2
# Academy lesson files (docs/academy.md); synced into the database when the API starts.
RIVERLAB_ACADEMY_CONTENT_DIR=../content/academy
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
# Server-side only: where the Next.js proxy forwards /api/backend/* requests.
RIVERLAB_API_URL=http://localhost:8000
FRONTEND_PORT=3000
